{
  "name": "kitchen-management",
  "version": "1.0.0",
  "description": "Kitchen cross platform application for plates and orders management",
  "main": "index.js",
  "private": true,
  "keywords": [
    "kitchen",
    "management",
    "feast",
    "bear"
  ],
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "build-electron": "ng build --source-map --base-href ./ && electron .",
    "package:linux": "electron-packager . kitchen-management --overwrite --asar=true --platform=linux --arch=x64 --icon=src/favicon.ico --prune=true --out=release-builds",
    "package:windows": "electron-packager . kitchen-management --overwrite --asar=true --platform=win32 --arch=ia32 --icon=src/favicon.ico --prune=true --out=release-builds --win32metadata.CompanyName=CE --win32metadata.FileDescription=CE --win32metadata.ProductName=\"Gestione Piastre\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozzelliandrea/kitchen-management.git"
  },
  "author": "https://github.com/bozzelliandrea",
  "license": "GNU General Public License v3.0",
  "bugs": {
    "url": "https://github.com/bozzelliandrea/kitchen-management/issues"
  },
  "homepage": "https://github.com/bozzelliandrea/kitchen-management#readme",
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "@primeuix/themes": "^3.1.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "net": "^1.0.2",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primeng": "21.1.10",
    "rxjs": "~7.8.1",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "tslib": "^2.9.1",
    "websocket": "^1.0.35",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@electron/packager": "^20.3.0",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^22.20.5",
    "@types/sockjs-client": "^1.5.4",
    "@types/stompjs": "^2.3.10",
    "electron": "^45.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~5.9.3"
  }
}
