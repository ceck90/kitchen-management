# Public port for the Nginx container.
KITCHEN_MANAGEMENT_PORT=8080

# Docker DNS name and port of the related backend service.
API_PROTOCOL=http
API_HOST=backend
API_PORT=8080
API_CONTEXT=
WEBSOCKET_ENDPOINT=http://backend:8080/ws
WEBSOCKET_DEFAULT_TOPIC=/topic/greetings
WEBSOCKET_PKMI_TOPIC=/topic/pkmi